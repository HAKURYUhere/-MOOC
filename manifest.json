{
  "manifest_version": 3,
  "name": "中国大学 MOOC 待办提醒",
  "description": "汇总中国大学 MOOC 页面中的作业、测验、考试、讨论等待完成任务，并在截止前提醒。",
  "version": "1.2.2",
  "action": {
    "default_title": "MOOC 待办提醒",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.icourse163.org/*",
        "https://*.icourse163.org/*",
        "https://www.universitymooc.com/*",
        "https://*.universitymooc.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.icourse163.org/*",
    "https://*.icourse163.org/*",
    "https://www.universitymooc.com/*",
    "https://*.universitymooc.com/*"
  ],
  "options_page": "options.html",
  "icons": {
    "128": "icon128.png"
  }
}
